# ─────────────────────────────────────────────────────────────
#  Formless — environment
#  Copy to .env  ·  never commit the real file
#  Comments live on their own lines. Never put a # after a value.
# ─────────────────────────────────────────────────────────────


# ═══ V1 — REQUIRED ═══════════════════════════════════════════

# ── Anvil ── PDF filling and generation
# Get: app.useanvil.com → Organization settings → API keys → Development
ANVIL_API_KEY=

# Anvil template EIDs — 20-char id per form.
# Get: upload PDF → Document AI tags it → Publish →
#      template page → "PDF Template ID / Cast EID" → copy.
# Source PDFs are in MD_files/. Anvil-assigned aliases in anvil_fields/.

# Application for Disability Insurance Benefits — 114 Anvil aliases
ANVIL_EID_SSA16=

# Disability Report — 336 Anvil aliases
ANVIL_EID_SSA3368=

# Work History Report — 320 Anvil aliases
ANVIL_EID_SSA3369=

# Medical release — 20 Anvil aliases
ANVIL_EID_SSA827=


# ── LLM ── speech → structured fields, and evidence relevance
# Get: console.anthropic.com → API keys. Requires a payment method.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5


# ═══ V1 — SPEECH ═════════════════════════════════════════════
# Deepgram handles speech-to-text in every supported language and
# text-to-speech in English and Spanish. Mandarin text-to-speech uses the
# matching voice installed in the applicant's browser or operating system.

# deepgram | browser
STT_PROVIDER=deepgram

# Get: console.deepgram.com → API Keys. ~$0.0077/min streaming.
DEEPGRAM_API_KEY=

# Medical model — materially better on drug and procedure names
DEEPGRAM_MODEL=nova-3-medical

# Keyterm prompting: up to 100 terms per request, boosts recognition
DEEPGRAM_KEYTERMS_FILE=./config/keyterms.txt

# Deepgram Aura 2 voices. These defaults may be overridden per deployment.
DEEPGRAM_TTS_MODEL_EN=aura-2-thalia-en
DEEPGRAM_TTS_MODEL_ES=aura-2-estrella-es
DEEPGRAM_TTS_SPEED=1.08


# ═══ CONFIG — not secrets, but must stay editable ════════════
# SSA revises these annually. Never hardcode them in source.

# 2026 Substantial Gainful Activity — non-blind
SGA_MONTHLY_LIMIT_NONBLIND_USD=1690

# 2026 SGA — statutorily blind
# NOTE: SGA is a SOFT FLAG, never an automatic rejection. IRWE deductions,
#       subsidies, and self-employment profit tests can all change the answer.
SGA_MONTHLY_LIMIT_BLIND_USD=2830

# 2026 — earnings for one work credit
EARNINGS_PER_CREDIT_USD=1890

# 2026 — annual maximum (4 credits)
EARNINGS_FOR_FOUR_CREDITS_USD=7560

# HIPAA Right of Access — provider must respond within this many days
HIPAA_ACCESS_DEADLINE_DAYS=30

# One extension permitted, written notice required before the deadline
HIPAA_EXTENSION_DAYS=30

# SSA-827 authorisation expiry
SSA827_VALIDITY_MONTHS=12

# Tracker — first reminder to the applicant
TRACKER_NUDGE_DAY=20

# Tracker — deadline passed, escalate
TRACKER_ESCALATE_DAY=30


# ═══ V2 — LATER ══════════════════════════════════════════════

# ── Twilio ── SMS reminders, then assisted calling
# Get: console.twilio.com → Account Info, then buy a number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Avatar ── rendered face
# simli | tavus | heygen
AVATAR_PROVIDER=
AVATAR_API_KEY=
AVATAR_ID=


# ═══ APP ═════════════════════════════════════════════════════
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
